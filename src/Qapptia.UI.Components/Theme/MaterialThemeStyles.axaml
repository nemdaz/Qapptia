<!-- Reference: https://m3.material.io/styles/color/static/baseline -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- Superficie base y niveles de contenedor -->
            <SolidColorBrush x:Key="M3SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowestBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#F1F3F5" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#E9ECEF" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#DEE2E6" />
            
            <!-- Texto e iconos -->
            <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#374151" />
            
            <!-- Bordes y divisores -->
            <SolidColorBrush x:Key="M3OutlineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#E5E7EB" />
            
            <!-- Acento y estado seleccionado -->
            <SolidColorBrush x:Key="M3PrimaryBrush" Color="#0B57D0" />
            <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#A8D1FF" />
            <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#002A5C" />
            <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#A8D1FF" />
            <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#002A5C" />
            
            <!-- Interaccion y controles -->
            <SolidColorBrush x:Key="M3HoverBrush" Color="#E0EDFF" />
            <SolidColorBrush x:Key="M3ControlBgBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- Superficie base y niveles de contenedor -->
            <SolidColorBrush x:Key="M3SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowestBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#F1F3F5" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#E9ECEF" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#DEE2E6" />
            
            <!-- Texto e iconos -->
            <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#111827" />
            <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#374151" />
            
            <!-- Bordes y divisores -->
            <SolidColorBrush x:Key="M3OutlineBrush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#E5E7EB" />
            
            <!-- Acento y estado seleccionado -->
            <SolidColorBrush x:Key="M3PrimaryBrush" Color="#0B57D0" />
            <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#A8D1FF" />
            <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#002A5C" />
            <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#A8D1FF" />
            <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#002A5C" />
            
            <!-- Interaccion y controles -->
            <SolidColorBrush x:Key="M3HoverBrush" Color="#E0EDFF" />
            <SolidColorBrush x:Key="M3ControlBgBrush" Color="#FFFFFF" />
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
            <!-- Superficie base y niveles de contenedor -->
            <SolidColorBrush x:Key="M3SurfaceBrush" Color="#121212" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowestBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="M3SurfaceContainerLowBrush" Color="#181818" />
            <SolidColorBrush x:Key="M3SurfaceContainerBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighBrush" Color="#282828" />
            <SolidColorBrush x:Key="M3SurfaceContainerHighestBrush" Color="#323232" />
            
            <!-- Texto e iconos -->
            <SolidColorBrush x:Key="M3OnSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="M3OnSurfaceVariantBrush" Color="#D1D5DB" />
            
            <!-- Bordes y divisores -->
            <SolidColorBrush x:Key="M3OutlineBrush" Color="#6B7280" />
            <SolidColorBrush x:Key="M3OutlineVariantBrush" Color="#374151" />
            
            <!-- Acento y estado seleccionado -->
            <SolidColorBrush x:Key="M3PrimaryBrush" Color="#A8C7FA" />
            <SolidColorBrush x:Key="M3OnPrimaryBrush" Color="#003062" />
            <SolidColorBrush x:Key="M3PrimaryContainerBrush" Color="#004A77" />
            <SolidColorBrush x:Key="M3OnPrimaryContainerBrush" Color="#C2E7FF" />
            <SolidColorBrush x:Key="M3SecondaryContainerBrush" Color="#004A77" />
            <SolidColorBrush x:Key="M3OnSecondaryContainerBrush" Color="#C2E7FF" />
            
            <!-- Interaccion y controles -->
            <SolidColorBrush x:Key="M3HoverBrush" Color="#2D333B" />
            <SolidColorBrush x:Key="M3ControlBgBrush" Color="#1F1F1F" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
