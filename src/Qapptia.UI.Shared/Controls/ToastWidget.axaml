<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Qapptia.UI.Shared.Controls"
             x:Class="Qapptia.UI.Shared.Controls.ToastWidget">
    
    <UserControl.Styles>
        <Style Selector="Border.toast">
            <Setter Property="Opacity" Value="0.0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.4" Easing="CubicEaseInOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.toast.open">
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <Border Classes="toast"
            Classes.open="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=controls:ToastWidget}}"
            Background="{Binding CurrentBackgroundBrush, RelativeSource={RelativeSource AncestorType=controls:ToastWidget}}" 
            BorderBrush="{Binding CurrentBorderBrush, RelativeSource={RelativeSource AncestorType=controls:ToastWidget}}" 
            BorderThickness="1"
            CornerRadius="4" Padding="16,12"
            BoxShadow="0 4 12 0 #20000000">
        <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=controls:ToastWidget}}" 
                   Foreground="{Binding CurrentForegroundBrush, RelativeSource={RelativeSource AncestorType=controls:ToastWidget}}" 
                   FontSize="15" FontWeight="Regular" TextAlignment="Left" />
    </Border>
</UserControl>
