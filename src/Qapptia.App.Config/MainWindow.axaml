<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Qapptia.App.Config.ViewModels"
        xmlns:controls="using:Qapptia.App.Config.Controls"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        Width="580" Height="550"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:Class="Qapptia.App.Config.MainWindow"
        x:DataType="vm:ConfigViewModel"
        Title="Qapptia - Configuración">

    <Window.Styles>
        <!-- Reducir tamaño de fuente de los Tabs -->
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>

        <!-- Footer Message Colors -->
        <Style Selector="TextBlock.footerMessage">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#16a34a"/>
        </Style>
        <Style Selector="TextBlock.footerMessage.error">
            <Setter Property="Foreground" Value="#dc2626"/>
        </Style>
        
        <!-- Separadores para las secciones adaptables a M3 -->
        <Style Selector="HeaderedContentControl">
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel>
                        <TextBlock Text="{TemplateBinding Header}" FontWeight="SemiBold" Margin="0,8,0,4" Foreground="{DynamicResource M3PrimaryBrush}"/>
                        <Separator Margin="0,0,0,8" Height="1" Background="{DynamicResource M3OutlineVariantBrush}"/>
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="16">
        
        <!-- Tabs -->
        <TabControl Grid.Row="0" Margin="0,0,0,16">
            
            <!-- Pestaña General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10" Margin="8,8,8,8">
                        
                        <!-- Apariencia / Tema M3 -->
                        <HeaderedContentControl Header="Apariencia">
                            <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="Tema:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </HeaderedContentControl>

                        <!-- Guardado -->
                        <HeaderedContentControl Header="Guardado">
                            <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <!-- Directorio de guardado -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Guardar en:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SavePath}" Margin="0,0,8,0" />
                                <Button Grid.Row="0" Grid.Column="2" Content="Examinar..." Command="{Binding BrowsePathCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                                
                                <!-- Formato de archivo -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Formato archivo:" VerticalAlignment="Center" Margin="0,12,8,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilenameFormat}" Margin="0,12,8,0" PlaceholderText="Ej. Qapptia_YYYYMMDD_HHmmSS" />
                                <Button Grid.Row="1" Grid.Column="2" Content="?" Width="32" Height="32" Margin="0,12,0,0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <Button.Flyout>
                                        <Flyout>
                                            <TextBlock Text="Usa los siguientes valores para formatear la fecha:&#x0a;&#x0a;YYYY = Año (4 digitos)&#x0a;MM = Mes (2 digitos)&#x0a;DD = Día (2 digitos)&#x0a;HH = Horas&#x0a;mm = Minutos&#x0a;SS = Segundos" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </HeaderedContentControl>

                        <!-- Subcarpetas -->
                        <HeaderedContentControl Header="Subcarpetas de guardado">
                            <StackPanel Margin="0,4,0,0" Spacing="4">
                                <CheckBox Content="Crear subcarpeta por Mes" IsChecked="{Binding SubfolderMonth}" />
                                <CheckBox Content="Crear subcarpeta por Día" IsChecked="{Binding SubfolderDay}" />
                                <CheckBox Content="Crear subcarpeta por Hora" IsChecked="{Binding SubfolderHour}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Cursor -->
                        <HeaderedContentControl Header="Cursor">
                            <StackPanel Margin="0,4,0,0" Spacing="4">
                                <CheckBox Content="Capturar" IsChecked="{Binding ShowMouse}" />
                                <CheckBox Content="Resaltar (Halo)" IsChecked="{Binding HighlightMouse}" IsEnabled="{Binding ShowMouse}" />
                            </StackPanel>
                        </HeaderedContentControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Pestaña Captura -->
            <TabItem Header="Capturas">
                <StackPanel Spacing="8" Margin="8,8,8,8">
                    
                    <!-- Modo Pantalla Completa -->
                    <HeaderedContentControl Header="Modo Pantalla Completa">
                        <Grid ColumnDefinitions="90,*,110,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Atajo:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <controls:ShortcutTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShortcutScreen}" Margin="0,0,16,4" />
                            
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Temporizador:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding ManualTimer}" Minimum="0" Maximum="999" Increment="1" Margin="0,0,0,4" HorizontalAlignment="Stretch" />

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Content="Copiar al portapapeles automáticamente" IsChecked="{Binding CopyToClipboardScreen}" Margin="0,4,0,0" />
                        </Grid>
                    </HeaderedContentControl>

                    <!-- Modo Área -->
                    <HeaderedContentControl Header="Modo Área">
                        <Grid ColumnDefinitions="90,*,110,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Atajo:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <controls:ShortcutTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShortcutArea}" Margin="0,0,16,4" />
                            
                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Content="Copiar al portapapeles automáticamente" IsChecked="{Binding CopyToClipboardArea}" Margin="0,4,0,0" />
                        </Grid>
                    </HeaderedContentControl>

                </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding FooterMessage}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="footerMessage" Classes.error="{Binding IsFooterError}" />
            <Button Grid.Column="1" Content="Guardar" Command="{Binding SaveCommand}" Margin="0,0,8,0" Classes="accent" />
            <Button Grid.Column="2" Content="Cerrar" Command="{Binding CloseCommand}" />
        </Grid>
        
    </Grid>
</Window>
