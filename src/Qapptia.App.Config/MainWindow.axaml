<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Qapptia.App.Config.ViewModels"
        xmlns:controls="using:Qapptia.App.Config.Controls"
        xmlns:core="using:Qapptia.Core"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="530"
        Width="580" Height="530"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:Class="Qapptia.App.Config.MainWindow"
        x:DataType="vm:ConfigViewModel"
        Background="{DynamicResource M3SurfaceBrush}"
        Icon="avares://Qapptia.App.Config/Assets/config_icon.ico"
        Title="Configuración">

    <Window.Styles>
        <!-- Footer Message Colors -->
        <Style Selector="TextBlock.footerMessage">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#16a34a"/>
        </Style>
        <Style Selector="TextBlock.footerMessage.error">
            <Setter Property="Foreground" Value="#dc2626"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">
        
        <!-- Tabs -->
        <TabControl Grid.Row="0" Margin="16,12,16,8" SelectedIndex="{Binding SelectedTabIndex}">
            
            <!-- Pestaña General -->
            <TabItem Header="General">
                <StackPanel Spacing="16" Margin="16">
                    
                    <!-- Inicio del sistema -->
                    <HeaderedContentControl Header="Inicio del sistema">
                        <CheckBox Content="Iniciar automáticamente al encender el equipo"
                                  IsChecked="{Binding AutoStart}"
                                  IsEnabled="{Binding IsAutoStartSupported}"
                                  Margin="0,4,0,0" />
                    </HeaderedContentControl>

                    <!-- Apariencia / Tema M3 -->
                    <HeaderedContentControl Header="Apariencia">
                        <Grid ColumnDefinitions="120,*" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" Text="Tema:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </HeaderedContentControl>

                    <!-- Guardado -->
                    <HeaderedContentControl Header="Guardado">
                        <Grid ColumnDefinitions="120,*,Auto" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <!-- Directorio de guardado -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Guardar en:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SavePath}" Margin="0,0,8,0" IsReadOnly="True" />
                            <Button Grid.Row="0" Grid.Column="2" Content="Examinar..." Command="{Binding BrowsePathCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                            
                            <!-- Formato de archivo -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Formato archivo:" VerticalAlignment="Center" Margin="0,12,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilenameFormat}" Margin="0,12,8,0" PlaceholderText="Ej. Captura_YYYYMMDD_HHmmSS" />
                            <Button Grid.Row="1" Grid.Column="2" Content="?" Width="32" Height="32" Margin="0,12,0,0" Padding="0" HorizontalAlignment="Left" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                <Button.Flyout>
                                    <Flyout>
                                        <TextBlock Text="Usa los siguientes valores para formatear la fecha:&#x0a;&#x0a;YYYY = Año (4 digitos)&#x0a;MM = Mes (2 digitos)&#x0a;DD = Día (2 digitos)&#x0a;HH = Horas&#x0a;mm = Minutos&#x0a;SS = Segundos" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </HeaderedContentControl>

                    <!-- Subcarpetas -->
                    <HeaderedContentControl Header="Subcarpetas de guardado">
                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <CheckBox Content="Por Mes" IsChecked="{Binding SubfolderMonth}" />
                            <CheckBox Content="Por Día" IsChecked="{Binding SubfolderDay}" />
                            <CheckBox Content="Por Hora" IsChecked="{Binding SubfolderHour}" />
                        </StackPanel>
                    </HeaderedContentControl>

                </StackPanel>
            </TabItem>
            
            <!-- Pestaña Captura -->
            <TabItem Header="Captura">
                <StackPanel Spacing="16" Margin="16">
                        
                    <!-- Cursor -->
                    <HeaderedContentControl Header="Cursor">
                        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,4,0,0">
                            <CheckBox Content="Capturar cursor" IsChecked="{Binding ShowMouse}" />
                            <CheckBox Content="Resaltar (Halo)" IsChecked="{Binding HighlightMouse}" IsEnabled="{Binding ShowMouse}" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Modo Pantalla Completa -->
                    <HeaderedContentControl Header="Modo Pantalla Completa">
                        <Grid ColumnDefinitions="90,*,110,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Atajo:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <controls:ShortcutTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShortcutScreen}" Margin="0,0,16,4" />
                            
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Temporizador:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding ManualTimer}" Minimum="0" Maximum="999" Increment="1" Margin="0,0,0,4" HorizontalAlignment="Stretch" />

                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Content="Copiar al portapapeles automáticamente" IsChecked="{Binding CopyToClipboardScreen}" Margin="0,4,0,0" />
                            <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Content="Capturar todos los monitores en única imagen" IsChecked="{Binding CaptureAllScreens}" Margin="0,4,0,0" />
                        </Grid>
                    </HeaderedContentControl>

                    <!-- Modo Área -->
                    <HeaderedContentControl Header="Modo Área">
                        <Grid ColumnDefinitions="90,*,110,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Atajo:" VerticalAlignment="Center" Margin="0,0,8,4" />
                            <controls:ShortcutTextBox Grid.Row="0" Grid.Column="1" Text="{Binding ShortcutArea}" Margin="0,0,16,4" />
                            
                            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Content="Copiar al portapapeles automáticamente" IsChecked="{Binding CopyToClipboardArea}" Margin="0,4,0,0" />
                        </Grid>
                    </HeaderedContentControl>

                </StackPanel>
            </TabItem>

            <!-- Pestaña Editor -->
            <TabItem Header="Editor">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="16">
                    <PathIcon Data="{StaticResource IconConfig}" Width="32" Height="32" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock Text="Configuración del Editor" 
                               HorizontalAlignment="Center" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                    <TextBlock Text="Opciones avanzadas del lienzo y herramientas disponibles próximamente."
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                               Opacity="0.7" />
                </StackPanel>
            </TabItem>

            <!-- Pestaña Acerca de -->
            <TabItem Header="Acerca de">
                <StackPanel Spacing="16" Margin="16">
                        
                        <!-- Banner Superior: Nombre y Versión -->
                        <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="8" Padding="14">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                                       Source="avares://Qapptia.App.Config/Assets/app_icon.ico" 
                                       Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static core:Constants.LauncherAppName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource M3OnSurfaceBrush}" />
                                    <Border Background="{DynamicResource M3PrimaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source={x:Static core:Constants.AppVersion}, StringFormat='v{0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource M3OnPrimaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" 
                                           Text="{x:Static core:Constants.AppDescription}" 
                                           FontSize="12" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!-- Sección Apoyo / Colaboración (Random Icon + Random Text) -->
                        <HeaderedContentControl Header="{x:Static core:Constants.AboutSupportHeader}">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" 
                                           Text="{x:Static core:Constants.AboutSupportDescription}" 
                                           FontSize="12" Foreground="{DynamicResource M3OnSurfaceBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Button Grid.Column="1" 
                                        Command="{Binding SponsorCommand}"
                                        ToolTip.Tip="{Binding SponsorText}"
                                        Width="210"
                                        Height="36"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Classes="sponsor-button"
                                        Classes.SponsorStyleA="{Binding IsSponsorStyleA}"
                                        Classes.SponsorStyleB="{Binding IsSponsorStyleB}"
                                        Classes.SponsorStyleC="{Binding IsSponsorStyleC}"
                                        Classes.SponsorStyleD="{Binding IsSponsorStyleD}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding SponsorIcon}" Width="18" Height="18" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SponsorText}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </HeaderedContentControl>

                        <!-- Sección Comprobación y Actualización -->
                        <HeaderedContentControl Header="{x:Static core:Constants.AboutUpdatesHeader}">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding UpdateStatusMessage}" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource M3OnSurfaceBrush}" 
                                               TextWrapping="Wrap" />
                                    <ProgressBar IsIndeterminate="True" 
                                                 Height="4" 
                                                 IsVisible="{Binding IsCheckingUpdate}" 
                                                 HorizontalAlignment="Stretch" />
                                </StackPanel>

                                <Button Grid.Column="1" 
                                        Command="{Binding UpdateActionCommand}" 
                                        IsEnabled="{Binding CanExecuteUpdateAction}" 
                                        ToolTip.Tip="{Binding UpdateButtonText}"
                                        Width="210"
                                        Height="36"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Classes="outline-button"
                                        Classes.accent="{Binding IsUpdateAvailable}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource IconRefresh}" Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding !IsUpdateAvailable}" />
                                        <TextBlock Text="{Binding UpdateButtonText}" FontSize="14" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </HeaderedContentControl>

                    </StackPanel>
            </TabItem>

        </TabControl>

        <!-- Barra inferior de acciones (Footer) -->
        <Border Grid.Row="1" 
                Background="{DynamicResource M3SurfaceContainerLowBrush}" 
                BorderBrush="{DynamicResource M3OutlineVariantBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,12">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" 
                           Text="{Binding FooterMessage}" 
                           VerticalAlignment="Center" 
                           TextWrapping="Wrap" 
                           Classes="footerMessage" 
                           Classes.error="{Binding IsFooterError}" 
                           Margin="0,0,12,0" />
                <Button Grid.Column="1" 
                        Content="Guardar" 
                        Command="{Binding SaveCommand}" 
                        MinWidth="90" 
                        Height="32" 
                        HorizontalContentAlignment="Center" 
                        Classes="accent" 
                        Margin="0,0,8,0" />
                <Button Grid.Column="2" 
                        Content="Cerrar" 
                        Command="{Binding CloseCommand}" 
                        IsCancel="True"
                        MinWidth="90" 
                        Height="32" 
                        HorizontalContentAlignment="Center" />
            </Grid>
        </Border>
        
    </Grid>
</Window>
