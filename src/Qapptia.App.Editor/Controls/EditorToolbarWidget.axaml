<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Qapptia.App.Editor.ViewModels"
             xmlns:models="clr-namespace:Qapptia.Editor.Models;assembly=Qapptia.Editor"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="60"
             x:Class="Qapptia.App.Editor.Controls.EditorToolbarWidget"
             x:DataType="vm:EditorViewModel">
    <Border Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="8">
        <Grid ColumnDefinitions="*, Auto">
            <!-- Left aligned groups -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
            <!-- Grupo 1: Archivo y Portapapeles -->
            <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Guardar -->
                    <Button Command="{Binding SaveCommand}" ToolTip.Tip="Guardar" Background="Transparent" Padding="4">
                        <PathIcon Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm2 16H5V5h11.17L19 7.83V19zm-7-7c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zM6 6h9v4H6z" Width="16" Height="16"/>
                    </Button>
                    <!-- Copiar archivo -->
                    <Button Command="{Binding CopyFileCommand}" ToolTip.Tip="Copiar archivo (Ctrl+F)" Background="Transparent" Padding="4">
                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm-1 4H8c-1.1 0-1.99.9-1.99 2L6 21c0 1.1.89 2 1.99 2H19c1.1 0 2-.9 2-2V11l-6-6zM8 21V7h6v5h5v9H8z" Width="16" Height="16"/>
                    </Button>
                    <!-- Copiar contenido -->
                    <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copiar contenido (Ctrl+C)" Background="Transparent" Padding="4">
                        <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Grupo 2: Zoom y Vista -->
            <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Zoom -->
                    <ComboBox x:Name="ZoomComboBox" Width="95" IsEditable="True" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding SelectedZoomString}" Background="{DynamicResource M3ControlBgBrush}" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" VerticalContentAlignment="Center">
                        <ComboBox.Styles>
                            <Style Selector="TextBox">
                                <Setter Property="MaxLength" Value="5" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </ComboBox.Styles>
                    </ComboBox>
                    <!-- Ajustar imagen -->
                    <Button Command="{Binding FitImageCommand}" ToolTip.Tip="Ajustar imagen" Background="Transparent" Padding="4">
                        <PathIcon Data="M5 5h4V3H3v6h2V5zm5 14H5v-4H3v6h6v-2zm9-14h-4V3h6v6h-2V5zm-4 14h4v-4h2v6h-6v-2z" Width="16" Height="16"/>
                    </Button>
                    <!-- Tamaño real -->
                    <Button Command="{Binding RealSizeCommand}" ToolTip.Tip="Tamaño real" Background="Transparent" Padding="4">
                        <PathIcon Data="M15 3l2.3 2.3-2.89 2.87 1.42 1.42L18.7 6.7 21 9V3zM3 9l2.3-2.3 2.87 2.89 1.42-1.42L6.7 5.3 9 3H3zm6 12l-2.3-2.3 2.89-2.87-1.42-1.42L5.3 17.3 3 15v6zm12-6l-2.3 2.3-2.87-2.89-1.42 1.42 2.89 2.87L15 21h6z" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Grupo 3: Acciones Adicionales (Rotar) -->
            <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Rotar -->
                    <Button Command="{Binding RotateCommand}" ToolTip.Tip="Rotar" Background="Transparent" Padding="4">
                        <PathIcon Data="M2 13c0 4.97 4.03 9 9 9 1.76 0 3.4-.51 4.79-1.38l-1.46-1.46C13.34 19.69 12.2 20 11 20c-3.86 0-7-3.14-7-7s3.14-7 7-7h.17L9.59 7.59 11 9l4-4-4-4-1.42 1.41L11.17 4H11C6.03 4 2 8.03 2 13zm9 0 6 6 6-6-6-6-6 6zm6 3.17L13.83 13 17 9.83 20.17 13 17 16.17z" Width="16" Height="16"/>
                    </Button>
                    <!-- Recortar -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsCropToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Crop" GroupName="Tools" Background="Transparent" ToolTip.Tip="Recortar" Padding="4">
                        <PathIcon Data="M17 15h2V7c0-1.1-.9-2-2-2H9v2h8v8zM7 17V1H5v4H1v2h4v10c0 1.1.9 2 2 2h10v4h2v-4h4v-2H7z" Width="16" Height="16"/>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Grupo 4: Vectores y Dibujo -->
            <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="2">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <!-- Línea -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsLineToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Line" GroupName="Tools" Background="Transparent" ToolTip.Tip="Línea" Padding="4">
                        <PathIcon Data="M18.59 4L20 5.41 5.41 20 4 18.59z" Width="16" Height="16"/>
                    </RadioButton>
                    <!-- Flecha -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsArrowToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Arrow" GroupName="Tools" Background="Transparent" ToolTip.Tip="Flecha" Padding="4">
                        <PathIcon Data="M19 5h-7v2h4.59L4.59 19 6 20.41 18 8.41V13h2V5z" Width="16" Height="16"/>
                    </RadioButton>
                    <!-- Elipse -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsEllipseToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Ellipse" GroupName="Tools" Background="Transparent" ToolTip.Tip="Elipse" Padding="4">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" Width="16" Height="16"/>
                    </RadioButton>
                    <!-- Rectángulo -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsRectangleToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Rectangle" GroupName="Tools" Background="Transparent" ToolTip.Tip="Rectángulo" Padding="4">
                        <PathIcon Data="M18 4H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H6V6h12v12z" Width="16" Height="16"/>
                    </RadioButton>
                    <!-- Resaltador -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsHighlighterToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Highlighter" GroupName="Tools" Background="Transparent" ToolTip.Tip="Resaltador" Padding="4">
                        <PathIcon Data="M80 0v-160h800V0H80Zm504-480L480-584 320-424l103 104 161-160Zm-47-160 103 103 160-159-104-104-159 160Zm-84-29 216 216-189 190q-24 24-56.5 24T367-263l-27 23H140l126-125q-24-24-25-57.5t23-57.5l189-189Zm0 0 187-187q24-24 56.5-24t56.5 24l104 103q24 24 24 56.5T857-640L669-453 453-669Z" Width="16" Height="16"/>
                    </RadioButton>
                    <!-- Texto -->
                    <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Text" GroupName="Tools" Background="Transparent" ToolTip.Tip="Texto" Padding="4">
                        <PathIcon Data="M5 4v3h5.5v12h3V7H19V4H5z" Width="16" Height="16"/>
                    </RadioButton>
                </StackPanel>
            </Border>
            
            <!-- Grupo 5: Colores -->
            <Border Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="4,2">
                <ItemsControl ItemsSource="{Binding AvailableColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PaletteColorItem}">
                            <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" 
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).SelectColorCommand}" 
                                         CommandParameter="{Binding}" 
                                         GroupName="Colors" 
                                         Background="Transparent" 
                                         Padding="6,1"
                                         CornerRadius="4"
                                         Margin="0"
                                         HorizontalAlignment="Stretch"
                                         HorizontalContentAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Brush}" BorderBrush="{DynamicResource M3PaletteOutlineBrush}" BorderThickness="1" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            </StackPanel>

            <!-- Right aligned settings -->
            <Border Grid.Column="1" Background="{DynamicResource M3SurfaceVariantBrush}" CornerRadius="6" Padding="2" VerticalAlignment="Center">
                <Button Command="{Binding OpenConfigCommand}" ToolTip.Tip="Configuración" Background="Transparent" Padding="4">
                    <PathIcon Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.06-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.73,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.06,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.43-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.49-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" Width="16" Height="16" />
                </Button>
            </Border>
        </Grid>
    </Border>

</UserControl>
