<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Qapptia.App.Editor.ViewModels"
             x:DataType="vm:EditorViewModel"
             x:Class="Qapptia.App.Editor.Controls.TextEditorWidget"
             ClipToBounds="False">
    
    <UserControl.Styles>
        <Style Selector="TextBox:focus">
            <Setter Property="Foreground" Value="{DynamicResource M3OnSurfaceBrush}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource M3ControlBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource M3PrimaryBrush}" />
        </Style>
    </UserControl.Styles>
    
    <!-- Barra de herramientas flotante de texto (Monomotor Skia) con Tokens M3 -->
    <Border Height="28" VerticalAlignment="Top"
            Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1" CornerRadius="4" Padding="4,2"
            HorizontalAlignment="Left"
            BoxShadow="0 2 8 0 #40000000">
        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <!-- Icono de arrastre (6 puntos) -->
            <Border Background="Transparent" 
                    Cursor="SizeAll" 
                    Padding="2,0" 
                    PointerPressed="DragHandle_PointerPressed"
                    PointerMoved="DragHandle_PointerMoved"
                    PointerReleased="DragHandle_PointerReleased"
                    ToolTip.Tip="Arrastrar">
                <PathIcon Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                          Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
            </Border>

            <!-- Control de tamaño -->
            <Button Content="-" Padding="6,2" FontSize="11" FontWeight="Bold" Click="DecreaseSize_Click" 
                    Background="{DynamicResource M3HoverBrush}" Foreground="{DynamicResource M3OnSurfaceBrush}" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center" />
            <TextBox x:Name="SizeTextBox" 
                     Text="24" 
                     VerticalAlignment="Center" 
                     VerticalContentAlignment="Center"
                     Foreground="{DynamicResource M3OnSurfaceBrush}" 
                     CaretBrush="{DynamicResource M3OnSurfaceBrush}"
                     FontSize="11" 
                     FontWeight="SemiBold" 
                     MinWidth="28" 
                     MaxWidth="36" 
                     Height="22"
                     Padding="2,1"
                     TextAlignment="Center" 
                     Background="{DynamicResource M3ControlBgBrush}"
                     BorderBrush="{DynamicResource M3OutlineBrush}"
                     BorderThickness="1"
                     CornerRadius="3"
                     KeyDown="SizeTextBox_KeyDown"
                     TextChanged="SizeTextBox_TextChanged"
                     LostFocus="SizeTextBox_LostFocus"
                     ToolTip.Tip="Tamaño del texto (Enter para confirmar)" />
            <Button Content="+" Padding="6,2" FontSize="11" FontWeight="Bold" Click="IncreaseSize_Click" 
                    Background="{DynamicResource M3HoverBrush}" Foreground="{DynamicResource M3OnSurfaceBrush}" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center" />
            
            <!-- Icono de información -->
            <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                      Width="13" Height="13" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                      ToolTip.Tip="Usa Shift + Enter para saltos de línea"
                      Margin="2,0,2,0" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
