<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Qapptia.App.Editor.ViewModels"
             xmlns:core="using:Qapptia.Editor.Core"
             x:DataType="vm:EditorViewModel"
             x:Class="Qapptia.App.Editor.Controls.TextEditorWidget"
             FontFamily="{x:Static core:Constants.TextToolFontFamilyName}"
             FontWeight="Normal"
             TextOptions.TextRenderingMode="Antialias"
             ClipToBounds="False">
    
    <UserControl.Styles>
        <Style Selector="TextBox#EditTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox#EditTextBox /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox#EditTextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TextBox#EditTextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="32,*" ClipToBounds="False">
        <!-- Barra de herramientas y arrastre -->
        <Border Grid.Row="0" Height="28" VerticalAlignment="Top"
                Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="4,2"
                HorizontalAlignment="Left"
                BoxShadow="0 2 8 0 #60000000">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <!-- Icono de arrastre (6 puntos) -->
                <Border Background="Transparent" 
                        Cursor="SizeAll" 
                        Padding="2,0" 
                        PointerPressed="DragHandle_PointerPressed"
                        PointerMoved="DragHandle_PointerMoved"
                        PointerReleased="DragHandle_PointerReleased"
                        ToolTip.Tip="Arrastrar">
                    <PathIcon Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                              Width="14" Height="14" Foreground="#888888" />
                </Border>

                <!-- Control de tamaño -->
                <Button Content="-" Padding="6,2" FontSize="11" FontWeight="Bold" Click="DecreaseSize_Click" 
                        Background="#2D2D30" Foreground="White" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding CurrentTextSize}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold" MinWidth="20" TextAlignment="Center" Background="Transparent" ToolTip.Tip="Tamaño del texto" />
                <Button Content="+" Padding="6,2" FontSize="11" FontWeight="Bold" Click="IncreaseSize_Click" 
                        Background="#2D2D30" Foreground="White" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center" />
                
                <!-- Icono de información -->
                <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                          Width="13" Height="13" Foreground="#9E9E9E"
                          ToolTip.Tip="Usa Shift + Enter para saltos de linea"
                          Margin="2,0,2,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Cuadro de edición -->
        <Border Grid.Row="1" Background="Transparent" 
                BorderBrush="#888888"
                BorderThickness="{x:Static core:Constants.TextToolBorderThickness}"
                CornerRadius="2">
            
            <!-- Cuadro de texto interactivo (Skia dibuja el texto en tiempo real; el TextBox gestiona el cursor y teclado) -->
            <TextBox x:Name="EditTextBox"
                     Text="{Binding CurrentTextContent, Mode=TwoWay}"
                     FontSize="{Binding CurrentTextSize}"
                     Foreground="Transparent"
                     SelectionBrush="#400078D7"
                     CaretBrush="{x:Static core:Constants.TextToolCaretBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     KeyDown="TextBox_KeyDown"
                     Padding="{x:Static core:Constants.TextToolPadding}"
                     MinWidth="100"
                     MinHeight="30" />
        </Border>
    </Grid>
</UserControl>
