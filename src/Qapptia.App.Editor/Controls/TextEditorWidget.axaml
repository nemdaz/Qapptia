<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Qapptia.App.Editor.ViewModels"
             x:DataType="vm:EditorViewModel"
             x:Class="Qapptia.App.Editor.Controls.TextEditorWidget">
    
    <Grid RowDefinitions="Auto,*" ClipToBounds="False">
        <!-- Control de tamaño -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="4" Padding="4,2"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,0,4"
                BoxShadow="0 2 8 0 #60000000">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="-" Padding="6,2" FontSize="11" FontWeight="Bold" Click="DecreaseSize_Click" 
                        Background="#2D2D30" Foreground="White" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTextSize}" VerticalAlignment="Center" Foreground="#E0E0E0" FontSize="11" FontWeight="SemiBold" MinWidth="20" TextAlignment="Center" />
                <Button Content="+" Padding="6,2" FontSize="11" FontWeight="Bold" Click="IncreaseSize_Click" 
                        Background="#2D2D30" Foreground="White" CornerRadius="3" MinWidth="22" HorizontalContentAlignment="Center"/>
                
                <!-- Icono de información -->
                <PathIcon Data="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
                          Width="13" Height="13" Foreground="#9E9E9E"
                          ToolTip.Tip="Usa Shift + Enter para saltos de linea"
                          Margin="2,0,2,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Contenedor y arrastre -->
        <Border Grid.Row="1" Background="Transparent" 
                BorderBrush="#888888"
                BorderThickness="1"
                CornerRadius="2"
                PointerPressed="Container_PointerPressed"
                PointerMoved="Container_PointerMoved"
                PointerReleased="Container_PointerReleased">
            
            <Grid>
                <!-- Sombra del texto -->
                <TextBlock Text="{Binding CurrentTextContent}"
                           FontSize="{Binding CurrentTextSize}"
                           Foreground="#A0000000"
                           Margin="2,2,0,0" 
                           Padding="5,4"
                           TextWrapping="Wrap" />

                <!-- Cuadro de texto -->
                <TextBox x:Name="EditTextBox"
                         Text="{Binding CurrentTextContent, Mode=TwoWay}"
                         FontSize="{Binding CurrentTextSize}"
                         Foreground="{Binding ActiveBrush}"
                         Background="Transparent"
                         BorderThickness="0"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         KeyDown="TextBox_KeyDown"
                         Padding="4"
                         MinWidth="100"
                         MinHeight="30" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
