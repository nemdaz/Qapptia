<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Qapptia.App.Editor.ViewModels"
        xmlns:controls="clr-namespace:Qapptia.App.Editor.Controls"
        xmlns:core="clr-namespace:Qapptia.Core;assembly=Qapptia.Core"
        xmlns:shared="clr-namespace:Qapptia.UI.Shared.Controls;assembly=Qapptia.UI.Shared"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Qapptia.App.Editor.MainWindow"
        x:DataType="vm:EditorViewModel"
        Title="Qapptia - Editor"
        Background="#1e1e1e"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Hover para Botones -->
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3e3e42" />
        </Style>
        
        <!-- Hover para RadioButtons (Herramientas) -->
        <Style Selector="RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3e3e42" />
        </Style>
        
        <!-- Estado Seleccionado (Checked) -->
        <Style Selector="RadioButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#4d4d4d" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3e3e42" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Actions -->
                <Button Command="{Binding SaveCommand}" ToolTip.Tip="Guardar" Background="Transparent" Padding="4">
                    <PathIcon Data="M17 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding RotateCommand}" ToolTip.Tip="Rotar imagen" Background="Transparent" Padding="4">
                    <Path Data="M16.75 22H12.25C8.5 22 7 20.5 7 16.75V12.25C7 8.5 8.5 7 12.25 7H16.75C20.5 7 22 8.5 22 12.25V16.75C22 20.5 20.5 22 16.75 22Z M2 9C2 5.13 5.13 2 9 2L7.95 3.75" 
                          Stroke="#d4d4d4" StrokeThickness="1.5" StrokeJoin="Round" StrokeLineCap="Round" Fill="Transparent" 
                          Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <Button Command="{Binding CopyFileCommand}" ToolTip.Tip="Copiar archivo (Ctrl+F)" Background="Transparent" Padding="4">
                    <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8V4h5v5h5v11z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copiar captura al portapapeles (Ctrl+C)" Background="Transparent" Padding="4">
                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </Button>
                
                <Separator Width="1" Background="#3e3e42" Margin="8,0" />

                <!-- Zoom -->
                <ComboBox x:Name="ZoomComboBox" Width="95" IsEditable="True" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding SelectedZoomString}" Background="#333333" Foreground="#d4d4d4" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBox.Styles>
                        <Style Selector="TextBox">
                            <Setter Property="MaxLength" Value="4" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
                <Button Click="FitImage_Click" ToolTip.Tip="Ajustar imagen" Background="Transparent" Padding="4">
                    <PathIcon Data="M5 5h4V3H3v6h2V5zm5 14H5v-4H3v6h6v-2zm9-14h-4V3h6v6h-2V5zm-4 14h4v-4h2v6h-6v-2z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </Button>
                <Button Command="{Binding RealSizeCommand}" ToolTip.Tip="Ajustar imagen a tamaño real" Background="Transparent" Padding="4">
                    <PathIcon Data="M15 3l2.3 2.3-2.89 2.87 1.42 1.42L18.7 6.7 21 9V3zM3 9l2.3-2.3 2.87 2.89 1.42-1.42L6.7 5.3 9 3H3zm6 12l-2.3-2.3 2.89-2.87-1.42-1.42L5.3 17.3 3 15v6zm12-6l-2.3 2.3-2.87-2.89-1.42 1.42 2.89 2.87L15 21h6z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </Button>

                <Separator Width="1" Background="#3e3e42" Margin="8,0" />

                <!-- Herramientas -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsLineToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Line" GroupName="Tools" Background="Transparent" ToolTip.Tip="Línea" Padding="4">
                    <PathIcon Data="M4 11h16v2H4z" Foreground="#d4d4d4" Width="16" Height="16">
                        <PathIcon.RenderTransform>
                            <RotateTransform Angle="-45" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsArrowToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Arrow" GroupName="Tools" Background="Transparent" ToolTip.Tip="Flecha" Padding="4">
                    <PathIcon Data="M16.01 11H4v2h12.01v3L20 12l-3.99-4v3z" Foreground="#d4d4d4" Width="16" Height="16">
                        <PathIcon.RenderTransform>
                            <RotateTransform Angle="-45" />
                        </PathIcon.RenderTransform>
                    </PathIcon>
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsEllipseToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Ellipse" GroupName="Tools" Background="Transparent" ToolTip.Tip="Elipse" Padding="4">
                    <PathIcon Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsRectangleToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Rectangle" GroupName="Tools" Background="Transparent" ToolTip.Tip="Rectángulo" Padding="4">
                    <PathIcon Data="M4 4v16h16V4H4zm14 14H6V6h12v12z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsHighlighterToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Highlighter" GroupName="Tools" Background="Transparent" ToolTip.Tip="Resaltador" Padding="4">
                    <PathIcon Data="M20.71 5.63l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-3.12 3.12-1.93-1.91-1.41 1.41 1.42 1.42L3 16.25V21h4.75l8.92-8.92 1.42 1.42 1.41-1.41-1.92-1.92 3.12-3.12c.4-.4.4-1.03.01-1.42zM6.92 19L5 17.08l8.06-8.06 1.92 1.92L6.92 19z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Text" GroupName="Tools" Background="Transparent" ToolTip.Tip="Texto" Padding="4">
                    <PathIcon Data="M5 4v3h5.5v12h3V7H19V4z" Foreground="#d4d4d4" Width="16" Height="16"/>
                </RadioButton>
                
                <Separator Width="1" Background="#3e3e42" Margin="8,0" />
                
                <ItemsControl ItemsSource="{Binding AvailableColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type SolidColorBrush}">
                            <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" 
                                         Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).SelectColorCommand}" 
                                         CommandParameter="{Binding}" 
                                         GroupName="Colors" 
                                         Background="Transparent" 
                                         Padding="4">
                                <!-- No enlazamos IsChecked por ahora, RadioButton manejará la selección visual con GroupName -->
                                <Ellipse Width="16" Height="16" Fill="{Binding}" Stroke="#d4d4d4" StrokeThickness="1" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Viewer -->
            <ScrollViewer Grid.Column="0" x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Background="#1e1e1e">
                    <!-- Mensaje si NO hay imagen -->
                    <TextBlock Text="Selecciona una imagen del Explorador para comenzar a editar." 
                               Foreground="#808080" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasNoImage}" />

                    <!-- Lienzo con fondo blanco (Visible solo cuando hay imagen) -->
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsVisible="{Binding HasImage}">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Border BoxShadow="0 4 16 0 #20000000" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" ClipToBounds="False">
                            <Panel ClipToBounds="False">
                                <controls:AnnotationCanvas x:Name="MainCanvas" ViewModel="{Binding}" />
                                <Canvas ClipToBounds="False">
                                    <controls:TextEditorWidget x:Name="TextOverlay" IsVisible="{Binding IsEditingText}"
                                                               Canvas.Left="{Binding CurrentTextBounds.X}"
                                                               Canvas.Top="{Binding CurrentTextBounds.Y}" />
                                </Canvas>
                            </Panel>
                        </Border>
                    </LayoutTransformControl>
                </Panel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" Background="#3e3e42" ResizeDirection="Columns" />

            <!-- Right Sidebar (Explorador) -->
            <Border Grid.Column="2" Background="#252526" BorderBrush="#3e3e42" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,12,12,8">
                        <TextBlock Grid.Column="0" Text="Explorador" Foreground="#d4d4d4" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Command="{Binding LoadSidebarImagesCommand}" Background="Transparent" Padding="4,2" ToolTip.Tip="Recargar" Foreground="White">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14" Foreground="#d4d4d4"/>
                        </Button>
                    </Grid>
                    
                    <TreeView Grid.Row="1" ItemsSource="{Binding SidebarFolders}" SelectedItem="{Binding SelectedNode}" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerTheme>
                            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="vm:ExplorerNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </ControlTheme>
                        </TreeView.ItemContainerTheme>
                        <TreeView.Styles>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <PathIcon x:Name="FolderIcon" Classes="folder" Width="16" Height="16" Foreground="#d4d4d4"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron /template/ PathIcon.folder">
                                <!-- Closed Folder (16x16 native) -->
                                <Setter Property="Data" Value="M1.5 2.5C1.5 1.94772 1.94772 1.5 2.5 1.5H5.80556C6.17706 1.5 6.52044 1.70678 6.69722 2.03102L7.54515 3.5H13.5C14.0523 3.5 14.5 3.94772 14.5 4.5V12.5C14.5 13.0523 14.0523 13.5 13.5 13.5H2.5C1.94772 13.5 1.5 13.0523 1.5 12.5V2.5Z" />
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron:checked /template/ PathIcon.folder">
                                <!-- Open Folder (16x16 native) -->
                                <Setter Property="Data" Value="M1 3.5C1 2.67157 1.67157 2 2.5 2H5.43845C5.83625 2 6.2177 2.15804 6.5 2.44034L7.55966 3.5H13.5C14.3284 3.5 15 4.17157 15 5V12.5C15 13.3284 14.3284 14 13.5 14H2.5C1.67157 14 1 13.3284 1 12.5V3.5ZM2.5 3C2.22386 3 2 3.22386 2 3.5V5H14V5C14 4.44772 13.5523 4 13.5 4H7.14645C6.94752 4 6.75672 3.92098 6.61612 3.78038L5.79289 2.95715C5.69911 2.86337 5.57195 2.81069 5.43934 2.81069H2.5Z" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="vm:ExplorerFolder" ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="vm:ExplorerFile">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Margin="2,0,0,0">
                                    <PathIcon Data="M2 3.5C2 2.67157 2.67157 2 3.5 2H12.5C13.3284 2 14 2.67157 14 3.5V12.5C14 13.3284 13.3284 14 12.5 14H3.5C2.67157 14 2 13.3284 2 12.5V3.5ZM13 12.5V11.2071L10.3536 8.56066C10.1583 8.3654 9.84171 8.3654 9.64645 8.56066L6.5 11.7071L5.35355 10.5607C5.15829 10.3654 4.84171 10.3654 4.64645 10.5607L3 12.2071V12.5C3 12.7761 3.22386 13 3.5 13H12.5C12.7761 13 13 12.7761 13 12.5Z" Width="14" Height="14" Foreground="#cccccc"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#e0e0e0" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>
            
        </Grid>

        <!-- Status Bar (Footer) -->
        <Border Grid.Row="2" Background="#2d2d30" BorderBrush="#3e3e42" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasImage}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImageWidth}" Foreground="#b0b0b0" FontSize="11" />
                    <TextBlock Text="x" Foreground="#b0b0b0" FontSize="11" />
                    <TextBlock Text="{Binding ImageHeight}" Foreground="#b0b0b0" FontSize="11" />
                    <TextBlock Text="px" Foreground="#b0b0b0" FontSize="11" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Listo" Foreground="#b0b0b0" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasImage}">
                        <TextBlock Text="Archivo:" Foreground="#808080" FontSize="11" />
                        <TextBlock Text="{Binding SelectedNode.Name}" Foreground="#b0b0b0" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toast Overlay -->
        <shared:ToastWidget Grid.Row="0" Grid.RowSpan="3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ZIndex="999"
                            Message="{Binding ToastMessage}"
                            Type="{Binding ToastType}"
                            IsOpen="{Binding IsToastVisible}" />
    </Grid>
</Window>
