<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Qapptia.App.Editor.ViewModels"
        xmlns:sidebar="clr-namespace:Qapptia.Editor.Sidebar.Models;assembly=Qapptia.Editor"
        xmlns:toolbar="clr-namespace:Qapptia.Editor.Toolbar.Models;assembly=Qapptia.Editor"
        xmlns:controls="clr-namespace:Qapptia.App.Editor.Controls"
        xmlns:core="clr-namespace:Qapptia.Core;assembly=Qapptia.Core"
        xmlns:shared="clr-namespace:Qapptia.UI.Components.Controls;assembly=Qapptia.UI.Components"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Qapptia.App.Editor.MainWindow"
        x:DataType="vm:EditorViewModel"
        Title="Qapptia - Editor"
        Icon="avares://Qapptia.App.Editor/Assets/app_icon.ico"
        Background="{DynamicResource M3SurfaceBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto, *, Auto">
        
        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- Guardar -->
                <Button Command="{Binding SaveCommand}" ToolTip.Tip="Guardar" Background="Transparent" Padding="4">
                    <PathIcon Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm2 16H5V5h11.17L19 7.83V19zm-7-7c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zM6 6h9v4H6z" Width="16" Height="16"/>
                </Button>
                <!-- Rotar -->
                <Button Command="{Binding RotateCommand}" ToolTip.Tip="Rotar" Background="Transparent" Padding="4">
                    <PathIcon Data="M2 13c0 4.97 4.03 9 9 9 1.76 0 3.4-.51 4.79-1.38l-1.46-1.46C13.34 19.69 12.2 20 11 20c-3.86 0-7-3.14-7-7s3.14-7 7-7h.17L9.59 7.59 11 9l4-4-4-4-1.42 1.41L11.17 4H11C6.03 4 2 8.03 2 13zm9 0 6 6 6-6-6-6-6 6zm6 3.17L13.83 13 17 9.83 20.17 13 17 16.17z" Width="16" Height="16"/>
                </Button>
                <!-- Copiar archivo -->
                <Button Command="{Binding CopyFileCommand}" ToolTip.Tip="Copiar archivo (Ctrl+F)" Background="Transparent" Padding="4">
                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm-1 4H8c-1.1 0-1.99.9-1.99 2L6 21c0 1.1.89 2 1.99 2H19c1.1 0 2-.9 2-2V11l-6-6zM8 21V7h6v5h5v9H8z" Width="16" Height="16"/>
                </Button>
                <!-- Copiar contenido -->
                <Button Command="{Binding CopyCommand}" ToolTip.Tip="Copiar contenido (Ctrl+C)" Background="Transparent" Padding="4">
                    <PathIcon Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z" Width="16" Height="16"/>
                </Button>
                
                <Separator Width="1" Background="{DynamicResource M3OutlineVariantBrush}" Margin="8,0" />

                <!-- Zoom -->
                <ComboBox x:Name="ZoomComboBox" Width="95" IsEditable="True" ItemsSource="{Binding ZoomOptions}" SelectedItem="{Binding SelectedZoomString}" Background="{DynamicResource M3ControlBgBrush}" Foreground="{DynamicResource M3OnSurfaceBrush}" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBox.Styles>
                        <Style Selector="TextBox">
                            <Setter Property="MaxLength" Value="4" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ComboBox.Styles>
                </ComboBox>
                <!-- Ajustar imagen -->
                <Button Click="FitImage_Click" ToolTip.Tip="Ajustar imagen" Background="Transparent" Padding="4">
                    <PathIcon Data="M5 5h4V3H3v6h2V5zm5 14H5v-4H3v6h6v-2zm9-14h-4V3h6v6h-2V5zm-4 14h4v-4h2v6h-6v-2z" Width="16" Height="16"/>
                </Button>
                <!-- Tamaño real -->
                <Button Command="{Binding RealSizeCommand}" ToolTip.Tip="Tamaño real" Background="Transparent" Padding="4">
                    <PathIcon Data="M15 3l2.3 2.3-2.89 2.87 1.42 1.42L18.7 6.7 21 9V3zM3 9l2.3-2.3 2.87 2.89 1.42-1.42L6.7 5.3 9 3H3zm6 12l-2.3-2.3 2.89-2.87-1.42-1.42L5.3 17.3 3 15v6zm12-6l-2.3 2.3-2.87-2.89-1.42 1.42 2.89 2.87L15 21h6z" Width="16" Height="16"/>
                </Button>

                <Separator Width="1" Background="{DynamicResource M3OutlineVariantBrush}" Margin="8,0" />

                <!-- Línea -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsLineToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Line" GroupName="Tools" Background="Transparent" ToolTip.Tip="Línea" Padding="4">
                    <PathIcon Data="M18.59 4L20 5.41 5.41 20 4 18.59z" Width="16" Height="16"/>
                </RadioButton>
                <!-- Flecha -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsArrowToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Arrow" GroupName="Tools" Background="Transparent" ToolTip.Tip="Flecha" Padding="4">
                    <PathIcon Data="M19 5h-7v2h4.59L4.59 19 6 20.41 18 8.41V13h2V5z" Width="16" Height="16"/>
                </RadioButton>
                <!-- Elipse -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsEllipseToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Ellipse" GroupName="Tools" Background="Transparent" ToolTip.Tip="Elipse" Padding="4">
                    <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z" Width="16" Height="16"/>
                </RadioButton>
                <!-- Rectángulo -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsRectangleToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Rectangle" GroupName="Tools" Background="Transparent" ToolTip.Tip="Rectángulo" Padding="4">
                    <PathIcon Data="M18 4H6c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H6V6h12v12z" Width="16" Height="16"/>
                </RadioButton>
                <!-- Resaltador -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsHighlighterToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Highlighter" GroupName="Tools" Background="Transparent" ToolTip.Tip="Resaltador" Padding="4">
                    <PathIcon Data="M80 0v-160h800V0H80Zm504-480L480-584 320-424l103 104 161-160Zm-47-160 103 103 160-159-104-104-159 160Zm-84-29 216 216-189 190q-24 24-56.5 24T367-263l-27 23H140l126-125q-24-24-25-57.5t23-57.5l189-189Zm0 0 187-187q24-24 56.5-24t56.5 24l104 103q24 24 24 56.5T857-640L669-453 453-669Z" Width="16" Height="16"/>
                </RadioButton>
                <!-- Texto -->
                <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding IsTextToolActive, Mode=OneWay}" Command="{Binding SelectToolCommand}" CommandParameter="Text" GroupName="Tools" Background="Transparent" ToolTip.Tip="Texto" Padding="4">
                    <PathIcon Data="M5 4v3h5.5v12h3V7H19V4H5z" Width="16" Height="16"/>
                </RadioButton>
                
                <Separator Width="1" Background="{DynamicResource M3OutlineVariantBrush}" Margin="8,0" />
                
                <ItemsControl ItemsSource="{Binding AvailableColors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type toolbar:PaletteColorItem}">
                            <RadioButton Theme="{StaticResource {x:Type ToggleButton}}" 
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).SelectColorCommand}" 
                                         CommandParameter="{Binding}" 
                                         GroupName="Colors" 
                                         Background="Transparent" 
                                         Padding="4">
                                <Ellipse Width="16" Height="16" Fill="{Binding Brush}" Stroke="{DynamicResource M3OutlineVariantBrush}" StrokeThickness="1" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>
            
            <!-- Canvas Viewer -->
            <ScrollViewer Grid.Column="0" x:Name="EditorScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Panel Background="{DynamicResource M3SurfaceBrush}">
                    <!-- Mensaje si NO hay imagen -->
                    <TextBlock Text="Selecciona una imagen del Explorador para comenzar a editar." 
                               Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="16" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding HasNoImage}" />

                    <!-- Lienzo con fondo blanco (Visible solo cuando hay imagen) -->
                    <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32" IsVisible="{Binding HasImage}">
                        <LayoutTransformControl.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </LayoutTransformControl.LayoutTransform>
                        <Border BoxShadow="0 4 16 0 #20000000" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}" ClipToBounds="False">
                            <Panel ClipToBounds="False">
                                <controls:AnnotationCanvas x:Name="MainCanvas" ViewModel="{Binding}" />
                                <Canvas ClipToBounds="False">
                                    <controls:TextEditorWidget x:Name="TextOverlay" IsVisible="{Binding IsEditingText}"
                                                               Canvas.Left="{Binding CurrentTextBounds.X}"
                                                               Canvas.Top="{Binding CurrentTextBounds.Y}" />
                                </Canvas>
                            </Panel>
                        </Border>
                    </LayoutTransformControl>
                </Panel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="4" Background="{DynamicResource M3OutlineVariantBrush}" ResizeDirection="Columns" />

            <!-- Right Sidebar (Explorador) -->
            <Border Grid.Column="2" Background="{DynamicResource M3SurfaceContainerBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="1,0,0,0">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="12,12,12,8">
                        <TextBlock Grid.Column="0" Text="Explorador" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- Recargar -->
                        <Button Grid.Column="1" Command="{Binding LoadSidebarImagesCommand}" Background="Transparent" Padding="4,2" ToolTip.Tip="Recargar">
                            <PathIcon Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" Width="14" Height="14"/>
                        </Button>
                    </Grid>
                    
                    <TreeView Grid.Row="1" ItemsSource="{Binding SidebarFolders}" SelectedItem="{Binding SelectedNode}" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerTheme>
                            <ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}" x:DataType="sidebar:SidebarItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </ControlTheme>
                        </TreeView.ItemContainerTheme>
                        <TreeView.Styles>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron">
                                <Setter Property="Width" Value="18" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Background="Transparent">
                                            <PathIcon x:Name="FolderIcon" Classes="folder" Width="16" Height="16" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron /template/ PathIcon.folder">
                                <!-- Carpeta cerrada -->
                                <Setter Property="Data" Value="M9.17 6l2 2H20v10H4V6h5.17M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" />
                            </Style>
                            <Style Selector="ToggleButton#PART_ExpandCollapseChevron:checked /template/ PathIcon.folder">
                                <!-- Carpeta abierta -->
                                <Setter Property="Data" Value="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.DataTemplates>
                            <TreeDataTemplate DataType="sidebar:SidebarFolder" ItemsSource="{Binding Items}">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent">
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontWeight="SemiBold" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                            <DataTemplate DataType="sidebar:SidebarFile">
                                <StackPanel Orientation="Horizontal" Spacing="6" Background="Transparent" Margin="2,0,0,0">
                                    <!-- Imagen -->
                                    <PathIcon Data="M19 5v14H5V5h14m0-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-4.86 8.86l-3 3.87L9 13.14 6 17h12l-3.86-5.14z" Width="14" Height="14" Foreground="{DynamicResource M3OnSurfaceVariantBrush}"/>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="13" Padding="0,2" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.DataTemplates>
                    </TreeView>
                </Grid>
            </Border>
            
        </Grid>

        <!-- Status Bar (Footer) -->
        <Border Grid.Row="2" Background="{DynamicResource M3SurfaceContainerHighBrush}" BorderBrush="{DynamicResource M3OutlineVariantBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasImage}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ImageWidth}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="x" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="{Binding ImageHeight}" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <TextBlock Text="px" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="Listo" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasImage}">
                        <TextBlock Text="Archivo:" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" FontSize="11" />
                        <TextBlock Text="{Binding SelectedNode.Name}" Foreground="{DynamicResource M3OnSurfaceBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Toast Overlay -->
        <shared:ToastWidget Grid.Row="0" Grid.RowSpan="3"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            ZIndex="999"
                            Message="{Binding ToastMessage}"
                            Type="{Binding ToastType}"
                            IsOpen="{Binding IsToastVisible}" />
    </Grid>
</Window>
