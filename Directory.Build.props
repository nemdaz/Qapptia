<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Plataforma mínima soportada para Windows (Windows 7 / NT 6.1) -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::IsOSPlatform('Windows'))">7.0</SupportedOSPlatformVersion>

    <!-- Constantes de compilación de plataforma para el SDK agnóstico net10.0 -->
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(DefineConstants);WINDOWS</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(DefineConstants);LINUX</DefineConstants>
    <DefineConstants Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(DefineConstants);MAC</DefineConstants>

    <!-- Identidad del producto -->
    <Company>Qapptia</Company>
    <Product>Qapptia</Product>
    <Authors>Qapptia</Authors>
    <Copyright>Copyright (c) Qapptia</Copyright>

    <!-- Versionado (SemVer 2.0.0) -->
    <VersionPrefix>2.0.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>

    <!-- Omitir ensamblados satélite de localización de paquetes de terceros -->
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- Compilación determinística y reproducible -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Central Package Management activo -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Análisis activo de Roslyn -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Salida unificada de binarios para toda la suite -->
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Optimizaciones de tamaño y runtime para compilaciones Release de producción -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Desactivar motor de depuración remota de CoreCLR (elimina mscordbi.dll y mscordaccore.dll) -->
    <DebuggerSupport>false</DebuggerSupport>
    <!-- Desactivar telemetría de eventos EventSource en BCL (elimina EventLog.Messages.dll) -->
    <EventSourceSupport>false</EventSourceSupport>
    <!-- Compactar mensajes de excepciones en System.Private.CoreLib -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Desactivar serializador binario inseguro obsoleto -->
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
  </PropertyGroup>

</Project>
