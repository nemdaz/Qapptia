<?xml version="1.0" encoding="utf-8"?>
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!-- Identidad del producto -->
    <Company>Qapptia</Company>
    <Product>Qapptia</Product>
    <Authors>Qapptia</Authors>
    <Copyright>Copyright (c) Qapptia</Copyright>

    <!-- Versionado (SerVer) — sobreescribir por proyecto si hace falta -->
    <VersionPrefix>0.1.0-alpha</VersionPrefix>
    <VersionSuffix></VersionSuffix>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>

    <!-- Compilación determinística y reproducible -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Central Package Management activo -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Análisis activo de Roslyn -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

</Project>
